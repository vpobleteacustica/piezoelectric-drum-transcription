+    def getCustomSplit(cls, folderPath=None, customDatasetRoot=None, cachePreprocessFolders=None, **kwargs):
+        """
+        Load a pre-split custom dataset with the structure:
+        TRAIN/AUDIO, TRAIN/ANNOTATIONS, VAL/AUDIO, VAL/ANNOTATIONS, TEST/AUDIO, TEST/ANNOTATIONS.
+        Audio and annotation files are paired by basename.
+        """
+        datasetRoot = customDatasetRoot or folderPath
+        if datasetRoot is None:
+            raise ValueError("custom_split requires folderPath or customDatasetRoot")
+
+        datasetRoot = os.path.abspath(datasetRoot)
+        splitNames = ("TRAIN", "VAL", "TEST")
+        audioPaths = []
+        annotationPaths = []
+        splitIndexes = {}
+
+        for splitName in splitNames:
+            splitAudioPaths, splitAnnotationPaths = cls._scanCustomSplit(datasetRoot, splitName)
+            startIndex = len(audioPaths)
+            audioPaths.extend(splitAudioPaths)
+            annotationPaths.extend(splitAnnotationPaths)
+            splitIndexes[splitName] = list(range(startIndex, len(audioPaths)))
+            logging.info("custom_split %s tracks: %s", splitName, len(splitAudioPaths))
+
+        if not audioPaths:
+            raise ValueError("custom_split found no paired WAV/TXT files under {}".format(datasetRoot))
+
+        if cachePreprocessFolders is None:

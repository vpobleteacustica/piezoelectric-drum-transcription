+            cachePreprocessFolders=cachePreprocessFolders,
+            checkFilesNameMatch=False,
+            crossValidation=False,
+            **kwargs,
+        )
+        dataset.trainIndexes = np.array(splitIndexes["TRAIN"])
+        dataset.valIndexes = np.array(splitIndexes["VAL"])
+        dataset.testIndexes = np.array(splitIndexes["TEST"])

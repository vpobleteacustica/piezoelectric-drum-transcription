+
+    @classmethod
+    def _scanCustomSplit(cls, datasetRoot, splitName):
+        audioFolder = os.path.join(datasetRoot, splitName, "AUDIO")
+        annotationFolder = os.path.join(datasetRoot, splitName, "ANNOTATIONS")
+
+        if not os.path.isdir(audioFolder):
+            logging.warning("custom_split %s missing AUDIO folder: %s", splitName, audioFolder)
+            return [], []
+        if not os.path.isdir(annotationFolder):
+            logging.warning("custom_split %s missing ANNOTATIONS folder: %s", splitName, annotationFolder)
+            return [], []
+
+        audioByBaseName = {
+            config.getFileBasename(path): path
+            for path in sorted(glob.glob(os.path.join(audioFolder, "*")))
+            if os.path.splitext(path)[1].lower() == ".wav"
+        }
+        annotationByBaseName = {
+            config.getFileBasename(path): path
+            for path in sorted(glob.glob(os.path.join(annotationFolder, "*")))
+            if os.path.splitext(path)[1].lower() == ".txt"
+        }
+
+        missingAnnotations = sorted(set(audioByBaseName) - set(annotationByBaseName))
+        missingAudio = sorted(set(annotationByBaseName) - set(audioByBaseName))
+        for basename in missingAnnotations:
+            logging.warning("custom_split %s orphan audio without annotation: %s", splitName, audioByBaseName[basename])
+        for basename in missingAudio:
+            logging.warning("custom_split %s orphan annotation without audio: %s", splitName, annotationByBaseName[basename])
+
+        pairedBaseNames = sorted(set(audioByBaseName) & set(annotationByBaseName))
+        return [audioByBaseName[name] for name in pairedBaseNames], [annotationByBaseName[name] for name in pairedBaseNames]
+
